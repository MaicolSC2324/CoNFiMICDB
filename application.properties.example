# ============================================
# CONFIGURACION DE CONFIMICDB
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo y nombra la copia como: application.properties
# 2. Edita los valores según tu configuración de MySQL
# 3. Coloca el archivo application.properties en la misma carpeta que el .exe
# ============================================

# CONEXION A BASE DE DATOS MySQL
# IMPORTANTE: allowPublicKeyRetrieval=true permite la autenticación con MySQL 8.0+
# serverTimezone=UTC especifica la zona horaria para evitar problemas
spring.datasource.url=jdbc:mysql://localhost:3306/confi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=tu_contraseña_mysql
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# CONFIGURACION DE JPA/HIBERNATE
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# SERVIDOR (No cambiar)
server.port=8080
server.servlet.context-path=/

# LOGGING (No cambiar)
logging.level.root=ERROR
logging.level.com.java.fx=INFO
logging.level.org.springframework.boot=ERROR

# ============================================
# CONFIGURACION OPCIONAL
# ============================================

# Tamaño máximo de upload (si es necesario)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Timeout de conexión (en milisegundos)
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.maximum-pool-size=5

# ============================================
# EJEMPLOS DE CONFIGURACION POR ENTORNO
# ============================================

# EJEMPLO 1: Si MySQL está en localhost (máquina local)
# spring.datasource.url=jdbc:mysql://localhost:3306/confi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.username=root
# spring.datasource.password=micontraseña

# EJEMPLO 2: Si MySQL está en un servidor remoto
# spring.datasource.url=jdbc:mysql://192.168.1.100:3306/confi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.username=usuario_mysql
# spring.datasource.password=micontraseña

# EJEMPLO 3: Si MySQL está en otro puerto (por defecto es 3306)
# spring.datasource.url=jdbc:mysql://localhost:3307/confi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.username=root
# spring.datasource.password=micontraseña

# EJEMPLO 4: Sin SSL (menos seguro pero más compatible)
# spring.datasource.url=jdbc:mysql://localhost:3306/confi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.username=root
# spring.datasource.password=micontraseña
