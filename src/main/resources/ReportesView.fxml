<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.java.fx.controllers.ReportesController"
            style="-fx-background-color: #FFFFFF;"
            maxHeight="Infinity" maxWidth="Infinity"
            prefHeight="800.0" prefWidth="1200.0">

    <top>
        <VBox style="-fx-background-color: #2C3E50; -fx-padding: 30px;" VBox.vgrow="NEVER">
            <Label text="Reportes" style="-fx-font-size: 36px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
            <Label text="Selecciona el reporte que deseas generar" style="-fx-font-size: 14px; -fx-text-fill: #ECF0F1; -fx-padding: 5px 0px 0px 0px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="30" style="-fx-padding: 40px; -fx-alignment: center;" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            <Label text="Reportes Disponibles" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

            <VBox spacing="15" style="-fx-alignment: center;">
                <Button fx:id="btnHorasYCiclos" text="📊  Horas y Ciclos por Aeronave"
                        prefWidth="500" prefHeight="70"
                        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #9B59B6; -fx-text-fill: #FFFFFF; -fx-padding: 15px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnUtilizacionFlota" text="📈  Utilización de la Flota"
                        prefWidth="500" prefHeight="70"
                        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #27AE60; -fx-text-fill: #FFFFFF; -fx-padding: 15px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnCalcularTiempos" text="⏱️  Calcular Tiempos Aeronaves"
                        prefWidth="500" prefHeight="70"
                        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #3498DB; -fx-text-fill: #FFFFFF; -fx-padding: 15px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnDisponibilidadFlota" text="📊  Disponibilidad General de Flota"
                        prefWidth="500" prefHeight="70"
                        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #E67E22; -fx-text-fill: #FFFFFF; -fx-padding: 15px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnAtasRepetitivas" text="⚠️  ATAS Repetitivas" onAction="#abrirAtasRepetitivas"
                        prefWidth="500" prefHeight="70"
                        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #C0392B; -fx-text-fill: #FFFFFF; -fx-padding: 15px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 20; -fx-background-color: #ECF0F1;" VBox.vgrow="NEVER">
            <Button fx:id="btnVolver" text="↩️ Volver"
                    prefWidth="100"
                    style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #E74C3C; -fx-text-fill: #FFFFFF; -fx-padding: 10px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>
