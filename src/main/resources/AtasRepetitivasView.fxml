<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.java.fx.controllers.AtasRepetitivasController"
            style="-fx-background-color: #FFFFFF;"
            maxHeight="Infinity" maxWidth="Infinity">

    <top>
        <VBox style="-fx-background-color: #2C3E50; -fx-padding: 30px;" VBox.vgrow="NEVER">
            <Label text="ATAS Repetitivas" style="-fx-font-size: 36px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
            <Label text="Análisis de fallos repetitivos por ATA" style="-fx-font-size: 14px; -fx-text-fill: #ECF0F1; -fx-padding: 5px 0px 0px 0px;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane style="-fx-background: transparent; -fx-background-color: transparent;" fitToHeight="false" fitToWidth="true">
            <VBox spacing="20" style="-fx-padding: 30px;">
                <!-- Sección de Parámetros de Consulta -->
                <VBox spacing="15" style="-fx-border-color: #ECF0F1; -fx-border-width: 1; -fx-padding: 20; -fx-background-color: #F8F9FA;">
                    <Label text="Parámetros de Consulta" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

                    <HBox spacing="30" VBox.vgrow="NEVER">
                        <!-- Año -->
                        <VBox spacing="8" HBox.hgrow="NEVER">
                            <Label text="Año:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                            <Spinner fx:id="spinnerYear" prefWidth="120" editable="true"/>
                        </VBox>

                        <!-- Meses -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Selecciona Meses:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                            <ListView fx:id="listviewMeses" prefHeight="140" style="-fx-font-size: 12px;" VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <!-- Aeronaves -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Selecciona Aeronaves:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                            <ListView fx:id="listviewAeronaves" prefHeight="140" style="-fx-font-size: 12px;" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button fx:id="btnGenerar" text="🔍 Generar Reporte"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #27AE60; -fx-text-fill: #FFFFFF; -fx-padding: 10px 20px; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                    </HBox>
                </VBox>

                <!-- Sección de Resultados -->
                <Label text="Resultados" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

                <TableView fx:id="tableAtas" prefHeight="400"
                    style="-fx-font-size: 12px; -fx-table-cell-text-fill: #000000;"
                    stylesheets="@chart-styles.css"/>

                <Label text="Gráfico de ATAS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 20px 0px 0px 0px;"/>
                <StackPane fx:id="chartContainer" prefHeight="500" style="-fx-border-color: #ECF0F1; -fx-border-width: 1; -fx-background-color: #FFFFFF;"/>

                <!-- Análisis por ATA Detallado -->
                <VBox spacing="15" style="-fx-border-color: #ECF0F1; -fx-border-width: 1; -fx-padding: 20; -fx-background-color: #F8F9FA; -fx-margin: 20px 0px 0px 0px;">
                    <Label text="Análisis Detallado por ATA" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Selecciona una ATA:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                            <ComboBox fx:id="comboBoxATA" prefWidth="200" style="-fx-font-size: 12px;"/>
                        </VBox>
                        <Button fx:id="btnMostrarATA" text="📊 Mostrar"
                                style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #3498DB; -fx-text-fill: #FFFFFF; -fx-padding: 8px 15px; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                    </HBox>
                </VBox>

                <StackPane fx:id="chartDetailedContainer" prefHeight="400" style="-fx-border-color: #ECF0F1; -fx-border-width: 1; -fx-background-color: #FFFFFF; -fx-padding: 10px;"/>

                <Label text="Tabla de SubATAs" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 20px 0px 0px 0px;"/>
                <TableView fx:id="tableSubAtas" prefHeight="400"
                    style="-fx-font-size: 12px; -fx-table-cell-text-fill: #000000;"
                    stylesheets="@chart-styles.css"/>

                <Label text="Detalles de Reportes de ATA" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50; -fx-padding: 20px 0px 0px 0px;"/>
                <TableView fx:id="tableDetallesAtas" prefHeight="400"
                    style="-fx-font-size: 12px; -fx-table-cell-text-fill: #000000;"
                    stylesheets="@chart-styles.css"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnMostrarTodosReportes" text="📋 Mostrar Todos los Reportes"
                            style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #3498DB; -fx-text-fill: #FFFFFF; -fx-padding: 8px 15px; -fx-border-radius: 5; -fx-background-radius: 5;"
                            visible="false" managed="false"/>
                </HBox>

                <Label text="Mensajes:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextArea fx:id="textAreaMensajes" prefHeight="80" wrapText="true" editable="false" style="-fx-font-size: 12px;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 20; -fx-background-color: #ECF0F1;" VBox.vgrow="NEVER">
            <Button fx:id="btnGestionarLibroVuelo" text="📖  Gestionar Libro de Vuelo"
                    prefWidth="200"
                    style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #27AE60; -fx-text-fill: #2C3E50; -fx-padding: 10px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="btnVolver" text="↩️ Volver"
                    prefWidth="100"
                    style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #E74C3C; -fx-text-fill: #2C3E50; -fx-padding: 10px; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>
